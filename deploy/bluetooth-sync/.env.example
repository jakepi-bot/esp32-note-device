# Copy to .env (same directory as docker-compose.yml) and fill in what you have.
# Every value is optional: with none of them set the server still accepts notes
# and stages them in data/notes/inbox, it just does not transcribe.

# --- transcription: any OpenAI-compatible /v1/audio/transcriptions -----------
# whisper.cpp's server:  http://192.168.1.20:8081/v1
# speaches/faster-whisper: http://192.168.1.20:8000/v1
STT_URL=
STT_MODEL=whisper-1
STT_API_KEY=
# "en" pins the language; empty lets the model decide.
STT_LANGUAGE=

# --- summaries: any OpenAI-compatible /v1/chat/completions -------------------
LLM_URL=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Some local servers do not implement response_format; set 0 for those.
LLM_JSON_MODE=1

# --- the endpoint ------------------------------------------------------------
# Only if the board was given an access token (X-Gadget-Token).
GADGET_ACCESS_TOKEN=
# Local time for the note's date (YYYY-MM-DD <title>.md).
TZ=America/Chicago

# What the phone types (and the certificate's name): must match exactly, and be
# a name, not a bare IP. "hermes.local" is the mDNS name of the host serving this.
RELAY_HOST=hermes.local

# Ports on the host.
NOTES_PORT=8766
RELAY_HTTP_PORT=8080
RELAY_HTTPS_PORT=8443
