# Waveshare ESP32-S3-ePaper-1.54 (V2): ESP32-S3PICO-1-N8R8 (8 MB octal PSRAM),
# 8 MB flash, 1.54" 200x200 e-paper (SSD1681-class) on SPI, ES8311 codec that
# carries both speaker and microphone, microSD slot (1-bit SDIO).
# Pins: docs/hardware.md#waveshare-esp32s3-epaper-154
CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# The 80 KB framebuffer, the e-paper image buffers and the audio buffers go
# to PSRAM.
CONFIG_SPIRAM_USE_MALLOC=y
# If PSRAM ever fails to start, boot anyway so the log and `diag` can say so.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The Type-C port is the S3's own USB Serial/JTAG and the console must live there:
# a secondary console is output-only, so commands typed over USB would never
# arrive. UART0 only reaches the header pads on this board.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_WS_EPAPER_154=y
# Battery life: scale the CPU down to 80 MHz when idle (see app_main).
CONFIG_PM_ENABLE=y
# Light sleep while dozing (on battery, screen off, idle; see EspSystem::enable_doze).
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# Light sleep is allowed while a USB host is connected: this is the bench's only
# way to see what the device does on a cell, since the console lives on that same
# cable. The cost is that the console drops while the chip sleeps, so every test
# wakes it with a key press first (2026-11-24).
# CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION is not set
# Wi-Fi wakes for each beacon from light sleep on the slow clock's timing; the
# 17.5 MHz / 256 oscillator drifts less than the default 150 kHz RC.
# CONFIG_RTC_CLK_SRC_INT_RC is not set
CONFIG_RTC_CLK_SRC_INT_8MD256=y
# Counts light sleep for the log line that ends each doze (EspSystem::set_dozing).
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
# Power the MAC/BB block down when the station is not in use. The notes app's
# battery default is "radio off between windows", so this is the common case, and
# a clocked-but-idle PHY is a milliamp or two for nothing.
CONFIG_ESP_PHY_MAC_BB_PD=y

# TCP windows for links with a long round trip (a phone hotspot): 5,760 B capped
# a connection near 33 KB/s at 175 ms, below 24 kHz audio's 48 KB/s.
# Wi-Fi and lwIP buffers in PSRAM first, internal RAM when the module has none.
# docs/porting.md#network-buffers
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Bluetooth LE: the phone app link (docs/protocol.md#phone-app-over-bluetooth)
# and the note sync the phone drives when there is no Wi-Fi
# (docs/ble-note-sync.md). NimBLE is about 200 KB of code, which the default
# 1.9 MB app slots cannot hold beside the firmware: this board is flashed with
# partitions-epaper-8mb.csv, two 3.875 MB slots, so an update still fits.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-epaper-8mb.csv"
CONFIG_BT_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# The note sync packs a notification to whatever MTU the phone asks for; this is
# the ceiling it asks for in return.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# Wi-Fi and Bluetooth share the antenna: keep the radio schedule fair, or a
# note uploads over Wi-Fi while the phone waits.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
